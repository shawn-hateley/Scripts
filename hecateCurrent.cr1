'Logger Name: Hecate Communications Node
'Pakbus ID: 30
'CR1000 serial #64937
'Revision history now maintained in Hakai GitHub repository

'==============================================================================
'>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Sensors in use <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
'==============================================================================
'1 x TypeT Thermocouple
'1 x HC2-S3 Air Temperature / Relative Humidity Probe
'1 x TB4M Tipping Bucket Rain Gauge
'1 X RM Young 05103-10 wind gauge   s/n:139029
'1 x SR50A Sonic Ranging Sensor   s/n:6802
'1 x 109 Temperature Probe - cable length 30ft

'==============================================================================
'>>>>>>>>>>>>>>>> Declare Constants, Variables, Units & Aliases <<<<<<<<<<<<<<<
'==============================================================================
Public BattVolt
Public PanelT
Public EnclosureTemp

Units BattVolt = Volts
Units PanelT = Deg C
Units EnclosureTemp = Deg C

SNMPVariable BattVolt 1.3.6.1.4.1.43592.12.1.1,FLOAT,RONLY
SNMPVariable PanelT 1.3.6.1.4.1.43592.12.1.2,FLOAT,RONLY
SNMPVariable EnclosureTemp 1.3.6.1.4.1.43592.12.1.3,FLOAT,RONLY

'Variables for TB4 Tipping Bucket Rain Gauge
Public Rain_mm
Public RainToday
Units Rain_mm = mm
Units RainToday = mm
Const RainGaugeMultiplier = 0.2

'Variables for HC2-S3 Temperature / Relative Humidity Probe
Public AirTemp
Units AirTemp = Deg C
Public RH
Units RH = %
Public DP
Units DP = Deg C
Public VP
Units VP = kPa

'Variables for 109-L temperature probe
Public AirTemp2
Units AirTemp2 = Deg C

'Variables for 05103-10-L Wind Speed / Direction sensor
Public WindSpd
Units WindSpd = m/s
Public WindDir
Units WindDir = degrees

'Variables used for calculating snow depth median value
Public SR50A(2)
Alias SR50A(1) = DT
Alias SR50A(2) = Q

Public SR50AReturnValues(11,2) As Float
Public SR50A_Distance As Float
Public SR50A_Distance_Std As Float
Public SR50A_Quality As Float
Public SR50A_TC_Distance As Float

Public SR50AState As Boolean

Units SR50A_Distance = m
Units SR50A_TC_Distance = m

Const RELAYCOUNT = 8
Public FlexScadaRelayState(RELAYCOUNT) As Boolean           'Holds the state of the flexscada relays

Public ControlFlexScadaRelays As Boolean = False            'If true the flexscada will sync with relay states held in the FlexScadaRelayState array.

Public MPPTMBResult, FSMBResult As Long
          
'Contains the current relay state of the program locally
Public LocalRelayState(RELAYCOUNT) as Boolean
Public LocalRelayStateNames(RELAYCOUNT) as String * 25

'flexscada port aliases
Alias LocalRelayState(1) = DockRadio
Alias LocalRelayState(2) = Camera1
Alias LocalRelayState(3) = BuxtonRadio
Alias LocalRelayState(4) = AISReceiver
Alias LocalRelayState(5) = CR1000Logger
Alias LocalRelayState(6) = CellRadio
Alias LocalRelayState(7) = EthernetSwitch
Alias LocalRelayState(8) = SW8

SNMPVariable LocalRelayStateNames(RELAYCOUNT) 1.3.6.1.4.1.43592.12.2.1.1,String,RONLY
SNMPVariable LocalRelayState(RELAYCOUNT) 1.3.6.1.4.1.43592.12.2.1.2,Integer,RWRITE

Public SolarPos(5)
Alias SolarPos(1) = SolarAzimuth
Alias SolarPos(2) = SunElevation
Alias SolarPos(3) = HourAngle
Alias SolarPos(4) = Declination
Alias SolarPos(5) = AirMass

Units SolarAzimuth = deg
Units SunElevation = deg
Units Declination = Rad
Units HourAngle = Rad

Public LowPowerMode As Boolean = False      'Flag to control UBNT radios and cameras when battery bank low
Public UltraLowPowerMode As Boolean = False   'Flag to control UBNT radios and cameras when battery bank ultra low
Public PowerModeChangeTS As Long = 0      'Timestamp of last power mode change
Public CommOveride as Boolean = True      'Flag to keep UBNT radios on during LowPowerMode

SNMPVariable LowPowerMode 1.3.6.1.4.1.43592.12.1.4,Integer,RONLY
SNMPVariable UltraLowPowerMode 1.3.6.1.4.1.43592.12.1.5,Integer,RONLY


'Prostar MPPT Controller Values
'https://www.morningstarcorp.com/wp-content/uploads/technical-doc-prostar-mppt-modbus-specification-en.pdf
