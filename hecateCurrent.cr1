Public RadioResponse, FlexResponse, Radio2Response AS Long


ConstTable
  Const MORNINGSTAR_COMPORT = ComRS232

  Const SR50ASDI12Port = 5
  Const SR50AAddress = "0"

  Const UTC_Offset = -8         'must be in units of seconds when used in SolarPosition
  Const Latitude = 51.682567      'Latitude of Station
  Const Longitude = -128.022783     'Longitude of Station
  Const Elevation = 479       'Elevation Constant (*MUST BE IN METERS*)

  Const MinSolarElevation = -6.5    'minimum altitude of the sun, used for webcam power control
  
  Const FlexScadaHost = "192.168.8.29"

  Const LowPowerThreshold = 24.60       'Sustained system voltage to trigger LowPowerMode
  Const UltraLowPowerThreshold = 24.20  'Sustained system voltage to trigger UltraLowPowerMode
EndConstTable

